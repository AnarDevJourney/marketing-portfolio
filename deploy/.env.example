# Production settings — copy to deploy/.env on the VPS and fill in.
# Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32
#
# Example below uses:
#   backend (DuckDNS):  https://sheila-portfolio.duckdns.org
#   site (Netlify):     https://sheila-portfolio.netlify.app

# --- API ---
JWT_SECRET=
JWT_EXPIRES_IN=12h
# The public site's origin(s) — the Netlify URL (and a custom domain later, comma-separated)
CORS_ORIGINS=https://sheila-portfolio.netlify.app

# --- MinIO (S3 storage for media) ---
MINIO_ACCESS_KEY=portfolio
MINIO_SECRET_KEY=
MINIO_BUCKET=media
# Public URL of the bucket = https://<backend domain>/<MINIO_BUCKET> (served by Nginx /media/)
MEDIA_PUBLIC_URL=https://sheila-portfolio.duckdns.org/media

# --- First admin (used by the seed command only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional ---
# Rebuild the Netlify site after admin edits (Netlify → Site configuration → Build hooks)
NETLIFY_BUILD_HOOK_URL=
# Contact form notifications, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
NOTIFY_EMAIL=
