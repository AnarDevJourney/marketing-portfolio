# Production settings — copy to deploy/.env on the VPS and fill in.
# Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32

# --- Domains (DNS A records of both point to this VPS) ---
API_DOMAIN=api.domain.az
MEDIA_DOMAIN=media.domain.az
# Let's Encrypt account e-mail (required: certificate expiry notices)
ACME_EMAIL=

# --- API ---
JWT_SECRET=
JWT_EXPIRES_IN=12h
# The public site's origin(s); add the *.netlify.app URL while testing before the domain is live
CORS_ORIGINS=https://domain.az,https://www.domain.az

# --- MinIO (S3 storage for media) ---
MINIO_ACCESS_KEY=portfolio
MINIO_SECRET_KEY=
MINIO_BUCKET=media
# Public URL of the bucket = https://<MEDIA_DOMAIN>/<MINIO_BUCKET>
MEDIA_PUBLIC_URL=https://media.domain.az/media

# --- First admin (used by the seed command only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional ---
# Rebuild the Netlify site after admin edits (Netlify → Site configuration → Build hooks)
NETLIFY_BUILD_HOOK_URL=
# Contact form notifications, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
NOTIFY_EMAIL=
